Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Preprocessor}"
{
	%Group Preprocessor
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Preprocessor/^*"
		}
		%File "Source/^*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Preprocessor true
	{
		&
		{
			MalterlibLibrary_Preprocessor ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Preprocessor;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Preprocessor true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Preprocessor true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Preprocessor true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Preprocessor;@(MalterlibTests)"
	//MalterlibTestFiles_Malterlib_Preprocessor "@('Test/*'->MakeAbsolute())"
}

