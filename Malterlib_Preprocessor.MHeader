Import "../Core/Lib_Malterlib.MTarget"

Property.MalterlibBoostModules =+ "preprocessor"

%Group "{Malterlib}/{Lib_Malterlib_Preprocessor}"
{
	%Group "Preprocessor"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Preprocessor/^*"
		}
		%File "Source/^*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}

Property
{
	MalterlibLibrary_Preprocessor define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Preprocessor"
	{
		!!MalterlibLibrary_Preprocessor true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Preprocessor define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Preprocessor true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Preprocessor"
	//MalterlibTestFiles_Malterlib_Preprocessor define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

